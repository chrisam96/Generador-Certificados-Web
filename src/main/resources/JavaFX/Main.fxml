<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="700.0" prefWidth="900.0" 
cacheShape="false" scaleShape="false" 
type="VBox" 
xmlns="http://javafx.com/javafx/21.0.12" 
xmlns:fx="http://javafx.com/fxml/1" 
fx:controller="mx.csam.certificados.GUI.CertificadosController">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="File">
          <items>
            <MenuItem mnemonicParsing="false" text="New" />
            <MenuItem mnemonicParsing="false" text="Open…" />
            <Menu mnemonicParsing="false" text="Open Recent" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Close" />
            <MenuItem mnemonicParsing="false" text="Save" />
            <MenuItem mnemonicParsing="false" text="Save As…" />
            <MenuItem mnemonicParsing="false" text="Revert" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Preferences…" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Quit" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Edit">
          <items>
            <MenuItem mnemonicParsing="false" text="Undo" />
            <MenuItem mnemonicParsing="false" text="Redo" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Cut" />
            <MenuItem mnemonicParsing="false" text="Copy" />
            <MenuItem mnemonicParsing="false" text="Paste" />
            <MenuItem mnemonicParsing="false" text="Delete" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Select All" />
            <MenuItem mnemonicParsing="false" text="Unselect All" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
          <items>
            <MenuItem mnemonicParsing="false" text="About MyHelloApp" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
      <ScrollPane id="scrollEscritura" fx:id="scrollEscritura" VBox.vgrow="NEVER" minHeight="120.0" fitToWidth="true">
         <content>
            <Pane prefHeight="106.0" >
	               <children>
	                  <Button id="btnGenerar" fx:id="btnGenerar" layoutX="693.0" layoutY="28.0" mnemonicParsing="false" onAction="#abrirFormulario" text="Generar" />
	                  <Label layoutX="14.0" layoutY="6.0" text="Oprima el botón &quot;Generar&quot; y rellene el formulario para crear el Certificado .cer y las keys correspondientes" />
	                  <Label fx:id="lblCertificados" layoutX="14.0" layoutY="32.0" text="[...].cer" />
	                  <Label fx:id="lblPubk" layoutX="14.0" layoutY="45.0" text="[...].pubkey" />
	                  <Label fx:id="lblPrik" layoutX="14.0" layoutY="62.0" text="[...].key" />
	               </children>
	         </Pane>
         </content>
      </ScrollPane>
      <!-- LE RESTE 25px DEL MENU_BAR 
      NOTA:
      PARA DEJAR QUE EL VBOX LAYOUT MANEJE LOS TAMAÑOS AUTOMATICAMENTE
      SE DEBEN USAR LAS PROPS:
      	VBox.vgrow="NEVER"/"ALWAYS"
      	fitToWidth="true"
      	fitToHeight="true"
      	
      	Y SI 
      	   public void start(Stage stage) 
      	O SEA
      	   EL CONFIGURADOR DE SCENE
      	SI AFECTA EL TAMAÑO REALMENTE
      -->
      <ScrollPane id="scrollLectura" fx:id="scrollLectura" prefHeight="555.0" prefWidth="900.0">
      <!--ScrollPane id="scrollLectura" fx:id="scrollLectura" VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="true" -->
         <content>
            <Pane prefHeight="541.0" prefWidth="886.0">
               <children>
                  <Label layoutX="20.0" layoutY="22.0" prefHeight="17.0" prefWidth="271.0" text="Aquí se mostrará la información sobre los archivos" />
                  <!--TextArea layoutX="20.0" layoutY="70.0" minHeight="440.0" minWidth="640.0" prefHeight="200.0" prefWidth="200.0" /-->
                  <TextArea layoutX="20.0" layoutY="70.0" prefHeight="440.0" prefWidth="640.0" />
                  
                  <Label id="lblCargarCer" fx:id="lblCargarCer" layoutX="700.0" layoutY="70.0" text="Cargar Certificado" />
                  <Button id="btnCargarCer" fx:id="btnCargarCer" layoutX="700.0" layoutY="95.0" mnemonicParsing="false" text="cargar archivo" />
                  <Label id="txtCargarCer" fx:id="txtCargarCer" layoutX="700.0" layoutY="125.0" text="[seleccione un archivo]" />
                  
                  <Label id="lblCargarPubk" fx:id="lblCargarCer" layoutX="700.0" layoutY="180.0" text="Cargar Public Key" />
                  <Button id="btnCargarPubk" fx:id="btnCargarCer" layoutX="700.0" layoutY="205.0" mnemonicParsing="false" text="cargar archivo" />
                  <Label id="txtCargarPubk" fx:id="txtCargarCer" layoutX="700.0" layoutY="235.0" text="[seleccione un archivo]" />
                  
                  <Label id="lblCargarPrik" fx:id="lblCargarCer" layoutX="700.0" layoutY="290.0" text="Cargar Private Key" />
                  <Button id="btnCargarPrik" fx:id="btnCargarCer" layoutX="700.0" layoutY="315.0" mnemonicParsing="false" text="cargar archivo" />
                  <Label id="txtCargarPrik" fx:id="txtCargarCer" layoutX="700.0" layoutY="345.0" text="[]seleccione un archivo]" />
                  
                  <Button id="btnAnalizar" fx:id="btnAnalizarArchFX" layoutX="700.0" layoutY="410.0" mnemonicParsing="false" onAction="#abrirLeerArchivos" text="Analizar archivo(s)" />
               </children>
         	</Pane>
         </content>
      </ScrollPane>   
  </children>
</fx:root>
